<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.NT118CryptoTracker"
        parent="Theme.Material3.Light.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface -->
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_input</item>
        <item name="colorOutline">@color/border_color</item>

        <!-- Error -->
        <item name="colorError">@color/negative_red</item>

        <!-- System bars -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default font -->
        <item name="android:fontFamily">@font/inter_regular</item>

        <!-- Controls -->
        <item name="android:colorAccent">@color/primary_blue</item>

    </style>

    <style name="Theme.NT118CryptoTracker"
        parent="Base.Theme.NT118CryptoTracker" />

    <!-- Typography -->
    <style name="TextAppearance.CryptoTracker.Heading">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CryptoTracker.Body">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CryptoTracker" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
