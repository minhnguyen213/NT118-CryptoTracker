<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý Danh mục đầu tư (Portfolio)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvPortfolioSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tổng tài sản: Đang tính..."
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#00C087"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etCoinSymbol"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Coin (VD: BTC)"
            android:inputType="textCapCharacters"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp"
            android:maxLines="1"/>

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent"/>

        <EditText
            android:id="@+id/etCoinAmount"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Số lượng (VD: 0.5)"
            android:inputType="numberDecimal"
            android:background="@android:drawable/edit_text"
            android:paddingHorizontal="12dp"
            android:maxLines="1"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnAddHolding"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="THÊM TÀI SẢN"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00C087"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh sách tài sản đã lưu:"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvHoldingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có tài sản nào."
            android:textColor="#333333"
            android:textSize="14sp"/>
    </ScrollView>

</LinearLayout>
