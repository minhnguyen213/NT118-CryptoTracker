<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:padding="14dp"
    android:background="@drawable/bg_coin_logo">

    <ImageView
        android:id="@+id/ivCoinLogo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:padding="6dp"
        android:src="@drawable/ic_market"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvCoinName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Bitcoin"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/ivCoinLogo"
        app:layout_constraintEnd_toStartOf="@id/tvCoinPrice"
        app:layout_constraintTop_toTopOf="@id/ivCoinLogo" />

    <TextView
        android:id="@+id/tvCoinSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="BTC"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvCoinName"
        app:layout_constraintTop_toBottomOf="@id/tvCoinName" />

    <TextView
        android:id="@+id/tvCoinPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$64,000.00"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvCoinName" />

    <TextView
        android:id="@+id/tvCoinChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="+5.24%"
        android:textColor="@color/positive_green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCoinPrice" />

</androidx.constraintlayout.widget.ConstraintLayout>
